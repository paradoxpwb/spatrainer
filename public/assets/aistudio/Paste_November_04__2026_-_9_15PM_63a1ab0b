기존 PracticeAttempt 타입을 하위 호환되게 확장한다.

권장 타입:

interface PracticeSession {
  id: string;
  questionId: string;
  question: string;
  category: string;
  difficulty: "basic" | "intermediate";
  createdAt: string;
  updatedAt: string;
  attemptIds: string[];
  originalAttemptId: string;
  latestAttemptId: string;
  status:
    | "in-progress"
    | "completed"
    | "abandoned";
}

interface PracticeAttempt {
  id: string;
  sessionId?: string;
  attemptNumber?: number;
  parentAttemptId?: string;
  retrySource?: "direct" | "feedback" | "history";

  questionId: string;
  category: string;
  question: string;
  recordedAt: string;
  recordingDurationSeconds: number;
  originalTranscript: string;
  editedTranscript: string;
  metrics: SpeakingMetrics;

  aiCoaching?: ExistingAICoachingType;

  retryContext?: {
    mode: "outline-only" | "improved-answer" | "direct";
    checklistItems: string[];
    sourceCoachingAttemptId?: string;
  };
}

interface AttemptComparison {
  sessionId: string;
  baseAttemptId: string;
  comparedAttemptId: string;
  generatedAt: string;

  metricChanges: MetricChange[];
  transcriptChanges: TranscriptComparison;
  checklistResults: ChecklistResult[];
  summary: ComparisonSummary;
}

interface MetricChange {
  metric:
    | "recording-duration"
    | "total-words"
    | "words-per-minute"
    | "filler-count"
    | "filler-rate"
    | "unique-words"
    | "lexical-diversity"
    | "repeated-words"
    | "repeated-phrases";

  previousValue: number;
  currentValue: number;
  absoluteChange: number;
  percentageChange: number | null;
  direction: "increased" | "decreased" | "unchanged";
  interpretation:
    | "improved"
