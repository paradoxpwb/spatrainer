6. 새로운 타입 구조
==================================================

types/question.ts를 하위 호환되게 확장한다.

권장 구조:

type PracticeMode =
  | "standard-question"
  | "follow-up-question"
  | "extended-response"
  | "listening-summary"
  | "visual-prompt";

interface PracticeAreaDefinition {
  id: PracticeAreaId;
  order: number;
  labelKo: string;
  labelEn: string;
  description: string;
  practiceMode: PracticeMode;
  defaultPreparationSeconds: number;
  defaultAnswerSeconds: number;
  enabled: boolean;
  availableTopicIds: TopicId[];
}

interface TopicDefinition {
  id: TopicId;
  labelKo: string;
  labelEn: string;
  description?: string;
  enabled: boolean;
}

interface BasePracticeItem {
  id: string;
  practiceArea: PracticeAreaId;
  topic: TopicId;
  difficulty: "basic" | "intermediate";
  title?: string;
  tags?: string[];
}

interface StandardSpeakingQuestion extends BasePracticeItem {
  practiceMode:
    | "standard-question"
    | "extended-response";

  question: string;
}

interface FollowUpSpeakingQuestion extends BasePracticeItem {
  practiceMode: "follow-up-question";
  question: string;
  followUpQuestions: string[];
}

interface ListeningSummaryQuestion extends BasePracticeItem {
  practiceMode: "listening-summary";
  passage: string;
  passageWordCount: number;
  estimatedListeningSeconds: number;
  playbackLimit: 2;
  keyPoints: string[];
  forbiddenVisibleDuringListening: true;
}

interface VisualPromptQuestion extends BasePracticeItem {
  practiceMode: "visual-prompt";
  question: string;
  visualType:
    | "photo"
    | "graph"
    | "table"
    | "map"
    | "text-prompt";
  visualAsset?: string;
  visualAlt: string;
  expectedElements?: string[];
}

type SpeakingQuestion =
  | StandardSpeakingQuestion
  | FollowUpSpeakingQuestion
  | ListeningSummaryQuestion
  | VisualPromptQuestion;

TypeScript discriminated union을 사용해 practiceMode별 필드를 안전하게 처리한다.

any 사용을 피한다.

